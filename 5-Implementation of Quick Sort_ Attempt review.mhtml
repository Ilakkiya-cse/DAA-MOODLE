void quickSort(int arr[], int low, int high) {
    if (low &lt; high) {
        int i =3D low;
        int j =3D high;
        int pivot =3D arr[low];

        while (i &lt; j) {
            while (arr[i] &lt;=3D pivot &amp;&amp; i &lt; high)
                i++;

            while (arr[j] &gt; pivot)
                j--;

            if (i &lt; j) {
                int temp =3D arr[i];
                arr[i] =3D arr[j];
                arr[j] =3D temp;
            }
        }

        int temp =3D arr[low];
        arr[low] =3D arr[j];
        arr[j] =3D temp;

        quickSort(arr, low, j - 1);
        quickSort(arr, j + 1, high);
    }
}

int main() {
    int n;
    scanf("%d", &amp;n);

    int arr[n];

    for (int i =3D 0; i &lt; n; i++)
        scanf("%d", &amp;arr[i]);

    quickSort(arr, 0, n - 1);

    for (int i =3D 0; i &lt; n; i++) {
        printf("%d", arr[i]);
        if (i &lt; n - 1)
            printf(" ");
    }

    return 0;
